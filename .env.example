# Copier ce fichier en .env.local et remplir les valeurs.

# --- Base de données ---
# En développement, lib/database.js se connecte au MySQL local de WAMP
# (localhost, root, base onlinereports) : rien à remplir.
# Les variables AIVEN_* ne servent qu'en production.
USE_LOCAL_DB=
AIVEN_HOST=
AIVEN_PORT=
AIVEN_USER=
AIVEN_PASSWORD=
AIVEN_DATABASE=

# --- NextAuth ---
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=

# --- Connexion Google ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Envoi d'emails (nodemailer) ---
EMAIL_USER=
EMAIL_PASSWORD=

# --- Chantier de démonstration ---
DEMO_CHANTIER_ID=
NEXT_PUBLIC_DEMO_CHANTIER_ID=

# --- Stripe (paiement, pas encore activé) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ESSENTIEL_MENSUEL=
STRIPE_PRICE_ESSENTIEL_ANNUEL=
STRIPE_PRICE_PRO_MENSUEL=
STRIPE_PRICE_PRO_ANNUEL=

# --- Script scripts/create-admin.js ---
# Mot de passe du compte admin (12 caractères minimum) ; email facultatif
ADMIN_EMAIL=
ADMIN_PASSWORD=

# --- Divers ---
# Niveau de logs : debug, info, warn, error
LOG_LEVEL=
